{
  "cSpell.words": [
    "antfu",
    "bitbucket",
    "bun",
    "bunx",
    "buymeacoffee",
    "CHEATSHEET",
    "cmdr",
    "cmds",
    "Codeium",
    "dein",
    "deinsoftware",
    "deno",
    "Eomm",
    "equiman",
    "esnext",
    "github",
    "gitlab",
    "kylejrp",
    "lcov",
    "linux",
    "lockb",
    "Logomark",
    "nargs",
    "nmpjs",
    "npmignore",
    "npmjs",
    "npmrc",
    "optstrings",
    "outdir",
    "patreon",
    "paypal",
    "pnpm",
    "postbuild",
    "sade",
    "setx",
    "spyb",
    "swpm",
    "swpx",
    "tryin",
    "unixish",
    "unpublish",
    "unstub",
    "versioner",
    "volta",
    "wslpath"
  ],
  "files.exclude": {
    "**/*.js.map": {
      "when": "$(basename)"
    },
    "**/node_modules": false
  },
  "js/ts.autoClosingTags": true,
  "js/ts.suggest.autoImports": true,
  "search.exclude": {
    "**/coverage": true,
    "**/node_modules": true
  },
  "js/ts.format.enable": false,
  "js/ts.validate.enable": true,
  "editor.formatOnSave": true,
  "eslint.validate": [
    "javascript",
    "typescript",
  ],
  "[javascript][typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
      "source.formatDocument": "explicit",
      "source.fixAll.eslint": "explicit"
    },
  },
  "explorer.fileNesting.patterns": {
    "README*": "BRAND*, CHANGELOG*, CODE_OF_CONDUCT.md, CONTRIBUTING.md, LICENSE*, README*, CHEATSHEET*, TEMPLATES*",
    "package*": ".gitignore, bunfig.toml, .npmignore, .eslintignore, .eslintrc.cjs, bun.lockb, tsconfig.json, vitest.config.ts, globals.d.ts",
    "*.js": "$(capture).*.js, $(capture).d.js.map, $(capture)_*.js, $(capture)*.snap",
    "*.ts": "$(capture).*.ts, $(capture).d.ts.map, $(capture)_*.ts, $(capture)*.snap",
  },
  "markdownlint.config": {
    "MD024": {
      "siblings_only": true,
    }
  },
  "testing.automaticallyOpenPeekView": "never",
}